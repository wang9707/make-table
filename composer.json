{
  "name": "wang9707/make-table",
  "description": "Laravel CRUD generator based on database tables",
  "keywords": ["laravel", "crud", "generator", "scaffold"],
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wang9707\\MakeTable\\": "src/"
    }
  },
  "require": {
    "php": ">=8.0.0",
    "laravel/framework": "^8.0|^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Wang9707\\MakeTable\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "authors": [
    {
      "name": "wang9707",
      "email": "1005945366@qq.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Wang9707\\MakeTable\\MakeTableServiceProvider"
      ]
    }
  }
}
